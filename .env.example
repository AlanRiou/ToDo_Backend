# Database
DB_KIND=mysql
DB_USERNAME=root
DB_PASSWORD=change-me
DB_JDBC_URL=jdbc:mysql://localhost:3306/checkly
DB_SCHEMA_STRATEGY=validate
DB_MIGRATE_AT_START=true
DB_BASELINE_ON_MIGRATE=true
CORS_ORIGINS=*

# Firebase Admin SDK
# Download this JSON from Firebase Console and keep it outside git.
FIREBASE_SERVICE_ACCOUNT_LOCATION=C:/secure-path/firebase-service-account.json

# App
APP_VERSION=dev
PORT=8080

# Cloud Run / Cloud SQL example:
# DB_USERNAME=checkly_app
# DB_JDBC_URL=jdbc:mysql:///checkly?cloudSqlInstance=PROJECT_ID:us-central1:checkly-mysql&socketFactory=com.google.cloud.sql.mysql.SocketFactory&useSSL=false
# FIREBASE_SERVICE_ACCOUNT_LOCATION=/secrets/firebase-service-account.json
